global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1' or env('align')

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

def envs(*args):
	for name in args:
		[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
		if x != '0' and y != '0':
			return 1

def notmath():
	return vim.eval('vimtex#syntax#in_mathzone()') == '0'
endglobal

context "math()"
snippet weq "weq" iA
W^{eq}
endsnippet

context "math()"
snippet peq "peq" iA
p^{eq}
endsnippet

context "math()"
snippet XX "banach space" iA
\mathcal{X}
endsnippet

context "math()"
snippet ss "stationary" iA
^{s}
endsnippet

context "math()"
snippet add "adiabatic" iA
^{ad}
endsnippet

context "math()"
snippet ddd "driving" iA
^{d}
endsnippet

context "math()"
snippet deg "degree" iA
^{($1)}$0
endsnippet






