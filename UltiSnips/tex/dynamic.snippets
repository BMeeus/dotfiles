global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1' or env('align') or env('gather')

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

def envs(*args):
	for name in args:
		[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
		if x != '0' and y != '0':
			return 1

def notmath():
	return not math()

def create_matrix_placeholders(snip):
	# Create anonymous snippet body
	anon_snippet_body = ""

	# Get start and end line number of expanded snippet
	start = snip.snippet_start[0]
	end = snip.snippet_end[0]

	  # Append current line into anonymous snippet
	for i in range(start, end + 1):
		anon_snippet_body += snip.buffer[i]
		anon_snippet_body += "" if i == end else "\n"

	# Delete expanded snippet line till second to last line
	for i in range(start, end):
		del snip.buffer[start]

	# Empty last expanded snippet line while preserving the line
	snip.buffer[start] = ''

	# Expand anonymous snippet
	snip.expand_anon(anon_snippet_body)

def create_matrix(cols, rows, sep, start, end):
	res = ""
	placeholder = 1
	for _ in range(0, int(rows)):
		res += start + f"${placeholder} "
		placeholder += 1
		for _ in range(0, int(cols) - 1):
			res += sep + f" ${placeholder} "
			placeholder += 1
		res += end
	return res[:-1]
endglobal

post_jump "create_matrix_placeholders(snip)"
snippet '(\d+),(\d+)mat' "nxm matrix" br
\begin{pmatrix}
`!p
snip.rv = create_matrix(match.group(1), match.group(2), "&", "\t", "\\\\\\\\\n")
`$0
\end{pmatrix}
endsnippet

post_jump "if snip.tabstop == 0: vim.eval('feedkeys(\"\<C-R>=UltiSnips#ExpandSnippet()\<CR>\")')"
snippet '(\d+)smat' "nxn square matrix" rb
`!p snip.rv = f"{match.group(1)},{match.group(1)}mat"`$0
endsnippet

post_jump "if snip.tabstop == 0: vim.eval('feedkeys(\"\<C-R>=UltiSnips#ExpandSnippet()\<CR>\")')"
snippet '(\d+)cvc' "n column vector" rb
`!p snip.rv = f"{1},{match.group(1)}mat"`$0
endsnippet



