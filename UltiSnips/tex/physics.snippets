global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1' or env('align')

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

def envs(*args):
	for name in args:
		[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
		if x != '0' and y != '0':
			return 1

def notmath():
	return vim.eval('vimtex#syntax#in_mathzone()') == '0'
endglobal

snippet vacper "vacuum permitivity" wA
\frac{1}{4 \pi \varepsilon_0}
endsnippet

snippet Qenc "Enclosed charge" wA
Q_{\text{enc}}
endsnippet

snippet Ienc "Enclosed current" wA
I_{\text{enc}}
endsnippet

context "math()"
snippet curl "curl" wA
\nabla \times 
endsnippet

context "math()"
snippet div "div" wA
\nabla \cdot 
endsnippet

priority 10000
context "math()"
snippet mu0 "mu0" A
\mu_0
endsnippet

priority 10000
context "math()"
snippet ep0 "epsilon0" A
\varepsilon_0
endsnippet

