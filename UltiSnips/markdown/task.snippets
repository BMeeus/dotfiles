global !p
from datetime import datetime
from os import urandom
today = datetime.today().strftime('%Y-%m-%d')
endglobal

snippet todo "ToDo item" w
- [ ] TODO $0 
endsnippet

priority 100
snippet ttodo "tiny ToDo item" w
- [ ] TODO tiny $0 
endsnippet

snippet prio "Set priority" w
[priority:: ${1:lowest/low/medium/high/highest}]$0
endsnippet

snippet due "Set due date" w
[due:: ${1}]$0
endsnippet

snippet 'due_(\d+)' "Set due date" wr
[due:: `!p
from datetime import date, timedelta

snip.rv = date.today() + timedelta(days=int(match.group(1)))
`]
endsnippet

snippet 'due_(\d*)(Mon|Tue|Wed|Thu|Fri|Sat|Sun)' "Set due date weekday" wr
[due:: `!p
import datetime 

if not match.group(1):
    wks = 0
else:
    wks = int(match.group(1))-1

onDay = lambda date, day: date + datetime.timedelta(days=(day-date.weekday()-1)%7+1, weeks = wks)

day_to_num = {"Mon": 0, "Tue": 1, "Wed": 2, "Thu": 3, "Fri": 4, "Sat": 5, "Sun": 6}

snip.rv = onDay(datetime.date.today(), day_to_num[match.group(2)])
`]
endsnippet

snippet start "Set start date" w
[start:: ${1}]$0
endsnippet

snippet done "Set done date" w
[completion:: ${1:`!p snip.rv = today`}]
endsnippet

snippet id "Create task id" w
[id:: ${1:`!p 
if not snip.c:
    snip.rv = urandom(3).hex()
`}]
endsnippet

snippet depend "Create dependence" w
[dependson:: ${1:task ID}]
endsnippet

